{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deepvein",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    // Single-page app: unknown paths like /party/ABCD load index.html.
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "deepvein.app", "custom_domain": true },
    { "pattern": "www.deepvein.app", "custom_domain": true }
  ]
}
